o":"I, 1–7"},{"id":"vergilio/eneida-parte-2","idioma":"la","tipo":"poema","titulo":"Aeneis","autor":"Vergílio","biblioteca":"/biblioteca/vergilio/eneida/","obra":"vergilio/eneida","parte":2,"trecho":"I, 8–11"}]}
