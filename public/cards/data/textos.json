{"versao":1,"textos":[{"id":"antonio-machado/proverbios-y-cantares-xxix","idioma":"es","tipo":"poema","titulo":"Proverbios y cantares, XXIX","autor":"Antonio Machado","biblioteca":"/biblioteca/antonio-machado/proverbios-y-cantares-xxix/"},{"id":"cervantes/quijote-parte-1","idioma":"es","tipo":"prosa","titulo":"Don Quijote de la Mancha","autor":"Miguel de Cervantes","biblioteca":"/biblioteca/cervantes/quijote/","obra":"cervantes/quijote","parte":1,"trecho":"En un lugar de la Mancha…"},{"id":"cervantes/quijote-parte-2","idioma":"es","tipo":"prosa","titulo":"Don Quijote de la Mancha","autor":"Miguel de Cervantes","biblioteca":"/biblioteca/cervantes/quijote/","obra":"cervantes/quijote","parte":2,"trecho":"Tenía en su casa…"},{"id":"cervantes/quijote-parte-3","idioma":"es","tipo":"prosa","titulo":"Don Quijote de la Mancha","autor":"Miguel de Cervantes","biblioteca":"/biblioteca/cervantes/quijote/","obra":"cervantes/quijote","parte":3,"trecho":"Quieren decir…"},{"id":"cervantes/quijote-parte-4","idioma":"es","tipo":"prosa","titulo":"Don Quijote de la Mancha","autor":"Miguel de Cervantes","biblioteca":"/biblioteca/cervantes/quijote/","obra":"cervantes/quijote","parte":4,"trecho":"Es, pues, de saber…"},{"id":"francisco-de-quevedo/amor-constante","idioma":"es","tipo":"poema","titulo":"Amor constante más allá de la muerte","autor":"Francisco de Quevedo","biblioteca":"/biblioteca/francisco-de-quevedo/amor-constante/"},{"id":"garcilaso-de-la-vega/soneto-xxiii","idioma":"es","tipo":"poema","titulo":"Soneto XXIII","autor":"Garcilaso de la Vega","biblioteca":"/biblioteca/garcilaso-de-la-vega/soneto-xxiii/"},{"id":"gustavo-adolfo-becquer/rima-xxi","idioma":"es","tipo":"poema","titulo":"Rima XXI","autor":"Gustavo Adolfo Bécquer","biblioteca":"/biblioteca/gustavo-adolfo-becquer/rima-xxi/"},{"id":"jorge-manrique/coplas-por-la-muerte-de-su-padre-parte-1","idioma":"es","tipo":"poema","titulo":"Coplas por la muerte de su padre","autor":"Jorge Manrique","biblioteca":"/biblioteca/jorge-manrique/coplas-por-la-muerte-de-su-padre/","obra":"jorge-manrique/coplas-por-la-muerte-de-su-padre","parte":1,"trecho":"Recuerde el alma dormida…"},{"id":"jose-marti/cultivo-una-rosa-blanca","idioma":"es","tipo":"poema","titulo":"Cultivo una rosa blanca","autor":"José Martí","biblioteca":"/biblioteca/jose-marti/cultivo-una-rosa-blanca/"},{"id":"sao-joao-da-cruz/noche-oscura-parte-1","idioma":"es","tipo":"poema","titulo":"Noche oscura","autor":"São João da Cruz","biblioteca":"/biblioteca/sao-joao-da-cruz/noche-oscura/","obra":"sao-joao-da-cruz/noche-oscura","parte":1,"trecho":"En una noche oscura…"},{"id":"sao-joao-da-cruz/noche-oscura-parte-2","idioma":"es","tipo":"poema","titulo":"Noche oscura","autor":"São João da Cruz","biblioteca":"/biblioteca/sao-joao-da-cruz/noche-oscura/","obra":"sao-joao-da-cruz/noche-oscura","parte":2,"trecho":"En la noche dichosa…"},{"id":"sao-joao-da-cruz/noche-oscura-parte-3","idioma":"es","tipo":"poema","titulo":"Noche oscura","autor":"São João da Cruz","biblioteca":"/biblioteca/sao-joao-da-cruz/noche-oscura/","obra":"sao-joao-da-cruz/noche-oscura","parte":3,"trecho":"¡Oh noche que guiaste…"},{"id":"sao-joao-da-cruz/noche-oscura-parte-4","idioma":"es","tipo":"poema","titulo":"Noche oscura","autor":"São João da Cruz","biblioteca":"/biblioteca/sao-joao-da-cruz/noche-oscura/","obra":"sao-joao-da-cruz/noche-oscura","parte":4,"trecho":"El aire de la almena…"},{"id":"edgar-allan-poe/annabel-lee-parte-1","idioma":"en","tipo":"poema","titulo":"Annabel Lee","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/annabel-lee/","obra":"edgar-allan-poe/annabel-lee","parte":1,"trecho":"It was many and many a…"},{"id":"edgar-allan-poe/annabel-lee-parte-2","idioma":"en","tipo":"poema","titulo":"Annabel Lee","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/annabel-lee/","obra":"edgar-allan-poe/annabel-lee","parte":2,"trecho":"I was a child and she…"},{"id":"edgar-allan-poe/annabel-lee-parte-3","idioma":"en","tipo":"poema","titulo":"Annabel Lee","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/annabel-lee/","obra":"edgar-allan-poe/annabel-lee","parte":3,"trecho":"And this was the reason that…"},{"id":"edgar-allan-poe/annabel-lee-parte-4","idioma":"en","tipo":"poema","titulo":"Annabel Lee","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/annabel-lee/","obra":"edgar-allan-poe/annabel-lee","parte":4,"trecho":"The angels, not half so happy…"},{"id":"edgar-allan-poe/annabel-lee-parte-5","idioma":"en","tipo":"poema","titulo":"Annabel Lee","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/annabel-lee/","obra":"edgar-allan-poe/annabel-lee","parte":5,"trecho":"But our love it was stronger…"},{"id":"edgar-allan-poe/annabel-lee-parte-6","idioma":"en","tipo":"poema","titulo":"Annabel Lee","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/annabel-lee/","obra":"edgar-allan-poe/annabel-lee","parte":6,"trecho":"For the moon never beams, without…"},{"id":"edgar-allan-poe/the-raven-parte-1","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":1,"trecho":"Once upon a midnight dreary, while…"},{"id":"edgar-allan-poe/the-raven-parte-10","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":10,"trecho":"But the raven, sitting lonely on…"},{"id":"edgar-allan-poe/the-raven-parte-11","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":11,"trecho":"Startled at the stillness broken by…"},{"id":"edgar-allan-poe/the-raven-parte-12","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":12,"trecho":"But the raven still beguiling all…"},{"id":"edgar-allan-poe/the-raven-parte-13","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":13,"trecho":"This I sat engaged in guessing…"},{"id":"edgar-allan-poe/the-raven-parte-14","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":14,"trecho":"Then, methought, the air grew denser…"},{"id":"edgar-allan-poe/the-raven-parte-15","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":15,"trecho":"“Prophet!” said I, “thing of evil!…”"},{"id":"edgar-allan-poe/the-raven-parte-16","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":16,"trecho":"By that Heaven that bends above us…"},{"id":"edgar-allan-poe/the-raven-parte-17","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":17,"trecho":"Be that word our sign of…"},{"id":"edgar-allan-poe/the-raven-parte-18","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":18,"trecho":"And the raven, never flitting, still…"},{"id":"edgar-allan-poe/the-raven-parte-2","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":2,"trecho":"Ah, distinctly I remember it was…"},{"id":"edgar-allan-poe/the-raven-parte-3","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":3,"trecho":"And the silken sad uncertain rustling…"},{"id":"edgar-allan-poe/the-raven-parte-4","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":4,"trecho":"Presently my soul grew stronger; hesitating…"},{"id":"edgar-allan-poe/the-raven-parte-5","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":5,"trecho":"Deep into that darkness peering, long…"},{"id":"edgar-allan-poe/the-raven-parte-6","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":6,"trecho":"Back into the chamber turning, all…"},{"id":"edgar-allan-poe/the-raven-parte-7","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":7,"trecho":"Open here I flung the shutter…"},{"id":"edgar-allan-poe/the-raven-parte-8","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":8,"trecho":"Then this ebony bird beguiling my…"},{"id":"edgar-allan-poe/the-raven-parte-9","idioma":"en","tipo":"poema","titulo":"The Raven","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/the-raven/","obra":"edgar-allan-poe/the-raven","parte":9,"trecho":"Much I marvelled this ungainly fowl…"},{"id":"edgar-allan-poe/to-helen","idioma":"en","tipo":"poema","titulo":"To Helen","autor":"Edgar Allan Poe","biblioteca":"/biblioteca/edgar-allan-poe/to-helen/"},{"id":"emily-dickinson/i-m-nobody-who-are-you","idioma":"en","tipo":"poema","titulo":"I'm nobody! Who are you?","autor":"Emily Dickinson","biblioteca":"/biblioteca/emily-dickinson/i-m-nobody-who-are-you/"},{"id":"john-donne/death-be-not-proud","idioma":"en","tipo":"poema","titulo":"Death, be not proud","autor":"John Donne","biblioteca":"/biblioteca/john-donne/death-be-not-proud/"},{"id":"john-keats/to-autumn-parte-1","idioma":"en","tipo":"poema","titulo":"To Autumn","autor":"John Keats","biblioteca":"/biblioteca/john-keats/to-autumn/","obra":"john-keats/to-autumn","parte":1,"trecho":"Season of mists and mellow fruitfulness…"},{"id":"john-keats/to-autumn-parte-2","idioma":"en","tipo":"poema","titulo":"To Autumn","autor":"John Keats","biblioteca":"/biblioteca/john-keats/to-autumn/","obra":"john-keats/to-autumn","parte":2,"trecho":"Who hath not seen thee oft…"},{"id":"john-keats/to-autumn-parte-3","idioma":"en","tipo":"poema","titulo":"To Autumn","autor":"John Keats","biblioteca":"/biblioteca/john-keats/to-autumn/","obra":"john-keats/to-autumn","parte":3,"trecho":"Where are the songs of spring…"},{"id":"robert-louis-stevenson/requiem","idioma":"en","tipo":"poema","titulo":"Requiem","autor":"Robert Louis Stevenson","biblioteca":"/biblioteca/robert-louis-stevenson/requiem/"},{"id":"william-shakespeare/sonnet-18","idioma":"en","tipo":"poema","titulo":"Sonnet 18","autor":"William Shakespeare","biblioteca":"/biblioteca/william-shakespeare/sonnet-18/"},{"id":"goncalves-dias/primeiros-cantos-cancao-do-exilio","idioma":"pt","tipo":"poema","titulo":"Canção do Exílio","autor":"Gonçalves Dias","biblioteca":"/biblioteca/goncalves-dias/primeiros-cantos-cancao-do-exilio/"},{"id":"arthur-rimbaud/le-dormeur-du-val","idioma":"fr","tipo":"poema","titulo":"Le Dormeur du val","autor":"Arthur Rimbaud","biblioteca":"/biblioteca/arthur-rimbaud/le-dormeur-du-val/"},{"id":"charles-baudelaire/l-albatros","idioma":"fr","tipo":"poema","titulo":"L’Albatros","autor":"Charles Baudelaire","biblioteca":"/biblioteca/charles-baudelaire/l-albatros/"},{"id"